# Copy to .env and pick ONE provider. All of these have a free option.
# Any OpenAI-compatible endpoint works: only the base URL, model id and key change.
# Model ids change often, so check the provider's model list and paste a current one.

JENKINS_ADMIN_PASSWORD=admin

# --- Option A: Groq (free tier, very fast). Key: https://console.groq.com/keys
# Models: https://console.groq.com/docs/models
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=gsk_your_key_here

# --- Option B: Google Gemini (free tier). Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<a current Gemini Flash model id>
# LLM_API_KEY=AIza_your_key_here

# --- Option C: OpenRouter free models. Key: https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<any model id ending in :free>
# LLM_API_KEY=sk-or-your_key_here

# --- Option D: Ollama, fully local, no key, no data leaves your machine.
# Start with:  docker compose --profile ollama up --build
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:3b
# LLM_API_KEY=not-needed
